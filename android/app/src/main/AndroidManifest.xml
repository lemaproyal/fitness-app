<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Thema"
        android:allowBackup="true">
        <!-- allowBackup bewusst an: Android darf die App-Daten in die Google-Sicherung
             aufnehmen. Eine Zusatzchance bei Handywechsel – die eigene Sicherung
             (Exportieren) ersetzt das nicht. -->

        <!-- singleTask: Nach „Darüber installieren“ und „Öffnen“ legt ein späterer Tipp aufs
             Symbol sonst ein zweites Fenster über das erste.
             configChanges: Drehen, Tastatur, Dunkelmodus, Schriftgröße oder Sprache sollen
             die Seite nicht neu laden – ein offener Dialog ginge sonst verloren. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|fontScale|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
